// Firestore security rules - basic role-based access example
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users collection: allow users to read their own profile and admins to read all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // products collection: anyone authenticated can read, only admins can write
    match /products/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // transactions collection: allow authenticated users to create, but not read/update/delete
    match /transactions/{transactionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // generic collections: admins full access, authenticated users can read
    match /{collection}/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    function isAdmin() {
      return request.auth.token.role == 'admin' || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
